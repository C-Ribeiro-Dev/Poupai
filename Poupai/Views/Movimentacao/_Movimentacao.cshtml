@model List<Poupai.ViewModel.MovimentacaoViewModel.MovimentacaoData>

@foreach (var item in Model)
{
	<div class="custom-table-row">
		<div class="custom-table-cell">
			<span class="cell-label">Data</span>
			<span class="cell-value">@item.Data</span>
		</div>
		<div class="custom-table-cell">
			<span class="cell-label">Descrição</span>
			<span class="cell-value">@item.Descricao</span>
		</div>
		<div class="custom-table-cell">
			<span class="cell-label">Categoria</span>
			<span class="cell-value">@item.TipoName</span>
		</div>
		<div class="custom-table-cell">
			@if (item.EntraOuSaida.ToLower().Contains("entrada"))
			{
				<span class="cell-label">Tipo</span>
				<span class="cell-value text-success">@item.EntraOuSaida</span>
			}
			else
			{
				<span class="cell-label ">Tipo</span>
				<span class="cell-value text-danger">@item.EntraOuSaida</span>
			}
		</div>

		<div class="custom-table-cell">
			@if (item.EntraOuSaida.ToLower().Contains("entrada"))
			{
				<span class="cell-label ">Valor</span>
				<span class="cell-value text-success">R$ @item.ValorSt</span>
			}
			else
			{
				<span class="cell-label">Valor</span>
				<span class="cell-value text-danger">R$ @item.ValorSt</span>
			}
		</div>
		<div class="card-bottons d-flex">
			<div style="margin-right:5px">
				<button onclick="getEditModal(@item.Id, this)" class="circle-btn edit" title="Editar">
					<i class="fa-solid fa-pen-to-square"></i>
				</button>


			</div>
			<div class="">
				<button onclick="deleteMovimentacao(@item.Id)" class="circle-btn delete" title="Excluir">
					<i class="fa-solid fa-trash"></i>
				</button>

			</div>
		</div>


	</div>
}