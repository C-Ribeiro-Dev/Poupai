@model Poupai.ViewModel.MovimentacaoViewModel.CreateMovimentacaoData

<div class="modal fade" id="editMovimentacaoModal" tabindex="-1" aria-labelledby="createTipoMovimentacaoLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content bg-dark text-light border-secondary">
			<div class="modal-header border-secondary">
				<h5 class="modal-title" id="createTipoMovimentacaoLabel">Editando Movimentação Financeira</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
			</div>
			<form id="form-edit-movimentacao" method="post" >
				<input type="hidden" asp-for="Id" />
				<div class="modal-body">
					<div class="mb-3">
						<label asp-for="Descricao" class="form-label">Descrição</label>
						<input asp-for="Descricao" class="form-control bg-dark text-light border-secondary" />
						<span asp-validation-for="Descricao" class="text-danger"></span>
					</div>
					<div class="mb-3">
						<label class="form-label text-light">Tipo de Movimentação</label>
						@Html.DropDownListFor(m => m.TipoId, Model.ListaTipos, "Selecionar Tipo",
															new { @class = "form-control bg-dark text-light border-secondary", id = "TipoMovimentacaoID" })
					</div>
					<div class="mb-3">
						<label asp-for="Valor" class="form-label">Valor</label>
						<input asp-for="Valor" class="form-control bg-dark text-light border-secondary" type="text"/>	
						<span asp-validation-for="Valor" class="text-danger"></span>
					</div>
					<div class="mb-3">
						<label asp-for="Data" class="form-label">Data</label>
						<input asp-for="Data" class="form-control bg-dark text-light border-secondary" />
						<span asp-validation-for="Data" class="text-danger"></span>
					</div>

				</div>
			</form>
			<div class="modal-footer border-secondary">
				<button type="button" onclick="editMovimentacao()" class="btn btn-success">Salvar</button>
			</div>
		</div>
	</div>
</div>
