@model Poupai.ViewModel.TipoMovimentacaoViewModel.TipoMovimentacaoData

<div class="modal fade" id="createTipoMovimentacaoModal" tabindex="-1" aria-labelledby="createTipoMovimentacaoLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content bg-dark text-light border-secondary">
			<div class="modal-header border-secondary">
				<h5 class="modal-title" id="createTipoMovimentacaoLabel">Novo Tipo de Movimentação</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
			</div>
			<div class="modal-body">
				<form id="form-tipomovimentacao" method="post">
					<div class="mb-3">
						<label asp-for="Nome" class="form-label"></label>
						<input asp-for="Nome" class="form-control bg-dark text-light border-secondary" />
						<span asp-validation-for="Nome" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="Descricao" class="form-label">Descrição</label>
						<input asp-for="Descricao" class="form-control bg-dark text-light border-secondary" />
						<span asp-validation-for="Descricao" class="text-danger"></span>
					</div>
					<div class="form-check mb-3">
						<input asp-for="IsEntrada" class="form-check-input" type="checkbox" id="IsEntrada" />
						<label class="form-check-label text-light" asp-for="IsEntrada">Entrada</label>
						<span asp-validation-for="IsEntrada" class="text-danger"></span>
					</div>
				</form>
				<div class="modal-footer border-secondary">
					<button onclick="createtipomovimentacao()" class="btn btn-success">Salvar</button>
				</div>
			</div>
		</div>
	</div>
</div>
