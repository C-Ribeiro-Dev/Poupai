# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave privada: usada apenas no servidor. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Banco de dados (Supabase > Project Settings > Database)
# DATABASE_URL: conexão com pooler (usada pela aplicação)
# DIRECT_URL: conexão direta (usada nas migrations do Prisma)
DATABASE_URL=
DIRECT_URL=

# E-mails com acesso à área administrativa, separados por vírgula
ADMIN_EMAILS=
