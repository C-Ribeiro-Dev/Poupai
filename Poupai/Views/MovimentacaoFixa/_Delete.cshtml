@model Poupai.ViewModel.MovimentacaoFixaViewModels.CreateMovimentacaoFixaData

<div class="modal fade" id="deleteMovimentacaoFixaModal" tabindex="-1" aria-labelledby="deleteMovimentacaoFixaModal" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content bg-dark text-light border-secondary">
			<div class="modal-header border-secondary">
				<h5 class="modal-title" id="deleteMovimentacaoFixaModal">Deletar essa Movimentação?</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
			</div>
			<form id="form-delete-movimentacao-fixa" method="post">
				<input asp-for="Id" type="hidden" />
				<div class="modal-body">
					<div class="mb-3">
						<label asp-for="Nome" class="form-label">Nome</label>
						<input asp-for="Nome" class="form-control bg-dark text-light border-secondary" readonly />
						<span asp-validation-for="Nome" class="text-danger"></span>
					</div>
					<div class="mb-3">
						<label asp-for="ValorS" class="form-label">Valor</label>
						<input asp-for="ValorS" class="form-control bg-dark text-light border-secondary" readonly />
						<span asp-validation-for="ValorS" class="text-danger"></span>
					</div>
					<div class="mb-3">
						<label asp-for="DataPagamento" class="form-label">Dia do Pagamento</label>
						<input asp-for="DataPagamento" type="date" class="form-control bg-dark text-light border-secondary" readonly/>
						<span asp-validation-for="DataPagamento" class="text-danger"></span>
					</div>
					<div class="mb-3">
						<label asp-for="FormaPagamento" class="form-label">Forma de Pagamento</label>
						<select asp-for="FormaPagamento" class="form-control bg-dark text-light border-secondary" readonly>
							<option value="Pix">Pix</option>
							<option value="Dinheiro">Dinheiro</option>
							<option value="Boleto">Boleto</option>
							<option value="Cartão">Cartão</option>
						</select>
						<span asp-validation-for="FormaPagamento" class="text-danger"></span>
					</div>
				</div>
			</form>
			<div class="modal-footer border-secondary">
				<button type="button" id="btn-delete-fixa" onclick="deletePagamento()" class="btn btn-success">Deletar</button>
			</div>
		</div>
	</div>
</div>
