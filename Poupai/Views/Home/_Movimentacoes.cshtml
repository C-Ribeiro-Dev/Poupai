@model Poupai.ViewModel.HomeViewModel.HomeData

@{
    var colorSaldo = Model.SaldoD >= 0 ? "text-success" : "text-danger";
}
<div class="row text-center">
    <div class="col-md-4 mb-3">
        <div class="card bg-dark text-light border-success shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Saldo Atual</h5>
                <p class="display-6 @colorSaldo">R$@Model.Saldo</p>
                @* <p class="display-6 text-success cell-value @(Model.SaldoD >= 0 ? "text-success" : "text-danger")">R$@Model.Saldo</p> *@

            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-dark text-light border-info shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Total de Entradas</h5>
                <p class="display-6 text-info">R$@Model.Entradas</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-dark text-light border-danger shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Total de Saídas</h5>
                <p class="display-6 text-danger">R$ @Model.Saidas</p>
            </div>
        </div>
    </div>
</div>
<div class="d-flex flex-column flex-md-row gap-3">
    <div class="flex-fill">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-light">Movimentações no mês de @Model.Mes</h4>
            @* <a href="@Url.Action("Index", "Movimentacao")" title="Novo Lançamento">
                <i class="fa fa-plus-circle fa-lg text-success"></i>
            </a> *@
            <a href="javascript:void(0);" onclick="getCreateModal(this)" title="Novo Lançamento">
                <i class="fa fa-plus-circle fa-lg text-success"></i>
            </a>

        </div>


        <div class="scroll-home">
            <div class="custom-table">
                @foreach (var item in Model.Moviments)
                {
                    <div class="custom-table-row">
                        <div class="custom-table-cell">
                            <span class="cell-label">Data</span>
                            <span class="cell-value">@item.Data</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Descrição</span>
                            <span class="cell-value">@item.Descricao</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Categoria</span>
                            <span class="cell-value">@item.TipoName</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Fixa</span>
                            <span class="cell-value">@item.Fixa</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Tipo</span>
                            <span
                                class="cell-value @(item.EntraOuSaida.ToLower().Contains("entrada") ? "text-success" : "text-danger")">@item.EntraOuSaida</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Valor</span>
                            <span
                                class="cell-value @(item.EntraOuSaida.ToLower().Contains("entrada") ? "text-success" : "text-danger")">R$
                                @item.ValorSt</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="border-left-divider "></div>
    <div class="flex-fill pl-3 ">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="text-light">Movimentações Fixas</h4>
            <a href="@Url.Action("Index", "MovimentacaoFixa")" title="Novo Lançamento">
                <i class="fa fa-plus-circle fa-lg text-success"></i>
            </a>
        </div>

        <div class="scroll-home">
            <div class="custom-table">
                @foreach (var item in Model.MovimentsFixas)
                {
                    <div class="custom-table-row">
                        <div class="custom-table-cell">
                            <span class="cell-label">Vencimento</span>
                            <span class="cell-value">@item.DataVencimento</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Nome</span>
                            <span class="cell-value">@item.Nome</span>
                        </div>
                        @* <div class="custom-table-cell">
                            <span class="cell-label">Categoria</span>
                            <span class="cell-value">@item.Categoria</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Data Ult/Pagamento</span>
                            <span class="cell-value">@item.UltimoPagamento</span>
                        </div> *@
                        <div class="custom-table-cell">
                            <span class="cell-label">Status</span>
                            <span
                                class="cell-value @(item.Status.ToLower().Contains("em dia") ? "text-success" : "text-danger")">@item.Status</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Status Pagamento</span>
                            <span
                                class="cell-value @(item.StatusPagamento.ToLower().Contains("em dia") ? "text-success" : "text-danger")">@item.StatusPagamento</span>
                        </div>
                        <div class="custom-table-cell">
                            <span class="cell-label">Valor</span>
                            <span class="cell-value">R$@item.Valor</span>
                        </div>
                        @if (!item.IsPago)
                        {
                            <div class="card-bottons d-flex">
                                <div id="btn-update-movimentacao-fixa" onclick="getUpDateModal(@item.Id)"
                                    class="circle-btn update" title="Confirmar Pagamento">
                                    <i class="fas fa-money-check"></i>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
